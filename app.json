{
  "expo": {
    "name": "GH Rotas",
    "slug": "gh-rotas-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/gh-rotas-brand.png",
    "scheme": "ghrotasapp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/gh-rotas-brand.png"
    },
    "android": {
      "package": "br.com.Ghrotas",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/gh-rotas-brand.png",
        "backgroundColor": "#E5E5E5"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/gh-rotas-brand.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E5E5E5",
          "image": "./assets/images/gh-rotas-brand.png",
          "imageWidth": 280,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permita que o GH Rotas use sua localização como ponto de partida da viagem."
        }
      ],
      "expo-image",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0d6c9631-fc80-4f18-a25a-704fc524b1e4"
      }
    },
    "owner": "guh008"
  }
}
